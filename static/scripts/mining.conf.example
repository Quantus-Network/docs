# Quantus mining configuration example
# Written by: ./quantus-mining.sh setup   or   .\quantus-mining.ps1 setup
# Location:   ~/quantus-mining/mining.conf   (owner-only permissions)
#
# This file holds public settings only. The reward preimage lives in the
# separate owner-only file ~/quantus-mining/rewards-inner-hash, and the
# 24-word recovery phrase is never written anywhere by the installer.

RUN_MODE="binary"

# Node name shown on https://telemetry.quantus.cat/
NODE_NAME="quantus-my-machine"

# Wormhole address where mining rewards accumulate (informational)
WORMHOLE_ADDRESS="qz..."

# P2P node identity file (relative to the working directory)
NODE_KEY_FILE="node_key.p2p"

# Chain spec. The installers only support planck.
CHAIN="planck"

# QUIC miner server port (node listens; miner connects via --node-addr).
# Auth files live in the node's chain dir, not here:
#   miner-auth-token, miner-tls-cert-sha256
MINER_LISTEN_PORT=9833

# External miner resource allocation
# GPU mining: GPU_DEVICES=1, CPU_WORKERS=0
# CPU-only:   GPU_DEVICES=0, CPU_WORKERS=<cores minus two>
CPU_WORKERS=0
GPU_DEVICES=1

# The pair the installer verified against the compatibility manifest.
# Not user-editable: start refuses to run if these drift from the manifest.
# To move to a newer published pair, re-run: setup --force
NODE_VERSION="v0.10.0"
MINER_VERSION="v4.0.2"
MINER_PROTOCOL="auth"

# Editable via: ./quantus-mining.sh config set KEY VALUE
#   NODE_NAME, CPU_WORKERS, GPU_DEVICES, MINER_LISTEN_PORT
#
# To change the reward destination, re-run setup --force and enter the
# recovery phrase for the wallet you want rewards sent to.
